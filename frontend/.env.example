# ─────────────────────────────────────────────
# SafeMap Frontend — Environment Variables
# ─────────────────────────────────────────────
# In this monorepo architecture, the frontend uses relative URL /api/v1.
# Local dev: Vite proxies /api requests to http://localhost:5000.
# Production: Express serves both frontend & API from the same origin.
# No VITE_API_URL or VITE_SOCKET_URL is required for standard deployment!

# Map Defaults
VITE_MAP_CENTER_LAT=28.6139
VITE_MAP_CENTER_LNG=77.2090
VITE_MAP_DEFAULT_ZOOM=12
