# ─────────────────────────────────────────────
# SafeMap Frontend — Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit the actual .env.local file to Git!

# Backend API base URL
# Local dev: http://localhost:5000/api/v1
# Production: https://safemap-backend.onrender.com/api/v1
VITE_API_URL=http://localhost:5000/api/v1

# Backend WebSocket URL
# Local dev: http://localhost:5000
# Production: https://safemap-backend.onrender.com
VITE_SOCKET_URL=http://localhost:5000
