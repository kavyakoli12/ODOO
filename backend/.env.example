# ─────────────────────────────────────────────
# SafeMap Backend — Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to Git!

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# URL of the frontend app (used for CORS)
# Local dev: http://localhost:5173
# Production: https://safemap-frontend.onrender.com
CLIENT_ORIGIN=http://localhost:5173

# JWT secrets — generate strong random strings for production
# Run this to generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your_strong_random_access_secret_here
JWT_REFRESH_SECRET=your_strong_random_refresh_secret_here

# Token expiry
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
