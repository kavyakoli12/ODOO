# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Use local MongoDB or MongoDB Atlas URI (e.g. mongodb+srv://<user>:<password>@cluster.mongodb.net/safemap?retryWrites=true&w=majority)
MONGODB_URI=mongodb://127.0.0.1:27017/safemap

# Frontend URL (CORS)
CLIENT_ORIGIN=http://localhost:5173

# Authentication Secrets (Will be used in Phase 2)
JWT_ACCESS_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long
JWT_REFRESH_SECRET=replace_with_another_secure_random_string_at_least_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary (Evidence files - Phase 8)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Odoo Integration (Phase 12)
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=
